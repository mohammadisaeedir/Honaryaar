[Unit]
Description=honaryaar Gunicorn
After=network.target

[Service]
User=honaryaar
Group=honaryaar
WorkingDirectory=/var/www/honaryaar
EnvironmentFile=/var/www/honaryaar/.env
ExecStart=/var/www/honaryaar/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile - \
    honaryaar.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
