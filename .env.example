# Local secrets belong in .env.local, which is git-ignored.
# Vercel injects the same names per environment. A change there is used only
# after a new deployment.
#
# Copy the endpoint, region, bucket, and keys from the ParsPack connection
# panel. Do not guess them. Prefer a separate bucket and key for each environment.
# Preview and development must not use the production prefix.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true

PARSPACK_ACCESS_KEY_ID=
PARSPACK_SECRET_ACCESS_KEY=
PARSPACK_ENDPOINT_URL=
PARSPACK_BUCKET_NAME=
PARSPACK_REGION_NAME=
PARSPACK_PUBLIC_MEDIA_BASE_URL=https://media.honaryaar.ir
MEDIA_STORAGE_PREFIX=dev

# Comma-separated browser origins allowed to upload directly.
# Leave empty locally to use http://127.0.0.1:8000 and http://localhost:8000.
# Preview must list its stable origin here. Production uses the public site
# origins when this is empty.
MEDIA_UPLOAD_ORIGINS=

# Remote media migration refuses every host until it is listed here.
MEDIA_MIGRATION_HOSTS=

MEDIA_PROFILE_MAX_ITEMS=12
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_VIDEO_BYTES=52428800
MEDIA_MAX_AUDIO_BYTES=15728640
MEDIA_PRESIGN_SECONDS=600
MEDIA_ABANDON_HOURS=24
