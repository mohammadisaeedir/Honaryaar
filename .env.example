# Local secrets belong in .env.local, which is git-ignored.
# Vercel injects the same names per environment. A change there is used only
# after a new deployment.
#
# Copy the endpoint, region, bucket, and keys from the ParsPack connection
# panel. Do not guess them. Prefer a separate bucket and key for each environment.
# Preview and development must not use the production prefix.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true

# Remote Postgres (Neon). When set, the app uses this instead of local Postgres.
# On the VPS set this to the production Neon URL and DJANGO_DEBUG=false.
DATABASE_URL=

# Comma-separated hosts / origins for the VPS (or leave defaults for honaryaar.ir).
DJANGO_ALLOWED_HOSTS=honaryaar.ir,www.honaryaar.ir
DJANGO_CSRF_TRUSTED_ORIGINS=https://honaryaar.ir,https://www.honaryaar.ir

# Optional Redis for catalog cache. Leave empty to use local redis://127.0.0.1:6379/0
# via REDIS_URL, or reuse Upstash (UPSTASH_REDIS_URL / KV_URL / REDIS_URL).
REDIS_URL=

# A superuser switches to these live rows from the admin account menu.
# The connection is read-only. Nothing is copied into the local database.
# Restart runserver after setting the URL. Unused when DATABASE_URL is set.
PROD_DATABASE_URL=

PARSPACK_ACCESS_KEY_ID=
PARSPACK_SECRET_ACCESS_KEY=
PARSPACK_ENDPOINT_URL=
PARSPACK_BUCKET_NAME=
PARSPACK_REGION_NAME=
PARSPACK_PUBLIC_MEDIA_BASE_URL=https://media.honaryaar.ir
MEDIA_STORAGE_PREFIX=dev

# Comma-separated browser origins allowed to upload directly.
# Leave empty locally to use http://127.0.0.1:8000 and http://localhost:8000.
# Preview must list its stable origin here. Production uses the public site
# origins when this is empty.
MEDIA_UPLOAD_ORIGINS=

# Remote media migration refuses every host until it is listed here.
MEDIA_MIGRATION_HOSTS=

MEDIA_PROFILE_MAX_ITEMS=12
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_VIDEO_BYTES=52428800
MEDIA_MAX_AUDIO_BYTES=15728640
MEDIA_PRESIGN_SECONDS=600
MEDIA_ABANDON_HOURS=24

# Push notifications (FCM). Leave PUSH_PROVIDER=log for local stub delivery.
# Set PUSH_PROVIDER=fcm and fill Firebase web + service-account values to go live.
PUSH_PROVIDER=log
NOTIFICATION_LOG_RETENTION_DAYS=90
# Path to the Firebase service-account JSON, or paste the JSON into FCM_CREDENTIALS_JSON.
FCM_CREDENTIALS_FILE=
FCM_CREDENTIALS_JSON=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
